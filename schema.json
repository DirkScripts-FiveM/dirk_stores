{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "x-label": "Stores",
  "x-icon": "store",
  "type": "object",
  "description": "Shops players buy from and sell to — where they are, who staffs them, what they stock and how they are paid.",
  "x-sections": [
    {
      "id": "general",
      "label": "General",
      "icon": "settings-2",
      "description": "How a player opens a store, and how the screen is dressed.",
      "paths": [
        "basic.interact",
        "basic.background",
        "basic.stopConflictingShops",
        "basic.catchOxStores"
      ]
    },
    {
      "id": "theme",
      "label": "Theme",
      "icon": "palette",
      "description": "Override the colours this script inherits from dirk_lib.",
      "paths": [
        "theme"
      ]
    },
    {
      "id": "payments",
      "label": "Payment",
      "icon": "wallet",
      "description": "The ways a player can pay, and be paid.",
      "paths": [
        "paymentMethods"
      ]
    },
    {
      "id": "licences",
      "label": "Licences",
      "icon": "scroll-text",
      "description": "The licences your city issues, and what needs one.",
      "paths": [
        "licenses"
      ]
    },
    {
      "id": "stores",
      "label": "Stores",
      "icon": "store",
      "description": "Every shop: where it is, who runs it, what it sells.",
      "paths": [
        "stores"
      ],
      "workspace": true
    }
  ],
  "x-managedElsewhere": [
    "access"
  ],
  "properties": {
    "basic": {
      "type": "object",
      "x-icon": "settings-2",
      "properties": {
        "interact": {
          "type": "string",
          "default": "target",
          "enum": [
            "target",
            "interact"
          ],
          "x-enumLabels": {
            "target": "Targeting (third-eye)",
            "interact": "Interaction prompt"
          },
          "x-enumIcons": {
            "target": "crosshair",
            "interact": "square-mouse-pointer"
          },
          "description": "How a player opens the shopkeeper — your target resource, or dirk_lib's on-screen prompt."
        },
        "background": {
          "type": "string",
          "default": "themed",
          "enum": [
            "themed",
            "dark",
            "transparent"
          ],
          "x-enumLabels": {
            "themed": "Tinted with your accent",
            "dark": "Plain dark",
            "transparent": "See the world behind"
          },
          "description": "What sits behind the store screen."
        },
        "catchOxStores": {
          "type": "boolean",
          "default": false,
          "description": "Answer ox_inventory's shop exports so scripts that open an ox shop open this one instead. Leave off unless something on your server calls them."
        },
        "stopConflictingShops": {
          "type": "boolean",
          "default": true,
          "description": "Stop the framework's own shop resources on start, so a counter does not end up with two shopkeepers on it. ox_inventory's built-in shops are part of the inventory and cannot be stopped — empty its data/shops.lua to remove those."
        }
      }
    },
    "theme": {
      "type": "object",
      "description": "Optional per-resource theme override. When it is on, every dirk_stores screen uses these colours instead of the global dirk_lib theme. A single store can still override this again on its own Look tab.",
      "x-enabledWhen": {
        "path": "theme.useOverride",
        "equals": true
      },
      "default": {
        "useOverride": false,
        "primaryColor": "dirk",
        "primaryShade": 5,
        "customTheme": [
          "#f0f4ff",
          "#d9e3ff",
          "#bfcfff",
          "#a6bbff",
          "#8ca7ff",
          "#7393ff",
          "#5a7fff",
          "#406bff",
          "#2547ff",
          "#0b33ff"
        ]
      },
      "properties": {
        "useOverride": {
          "type": "boolean",
          "default": false,
          "description": "Off means this script follows the global dirk_lib theme, so every dirk NUI matches. Turn it on only if you want stores to look different from the rest.",
          "x-goTo": {
            "resource": "dirk_lib",
            "group": "appearance",
            "label": "Change the global theme",
            "when": false
          }
        },
        "primaryColor": {
          "x-control": "mantineColor",
          "type": "string",
          "default": "dirk",
          "description": "Mantine palette name (or 'custom' to use the customTheme stops)."
        },
        "primaryShade": {
          "x-control": "shade",
          "type": "integer",
          "default": 5,
          "minimum": 0,
          "maximum": 9,
          "description": "Shade index 0-9 within the active palette."
        },
        "customTheme": {
          "type": "array",
          "default": [
            "#f0f4ff",
            "#d9e3ff",
            "#bfcfff",
            "#a6bbff",
            "#8ca7ff",
            "#7393ff",
            "#5a7fff",
            "#406bff",
            "#2547ff",
            "#0b33ff"
          ],
          "minItems": 10,
          "maxItems": 10,
          "description": "10-stop custom palette used when primaryColor = 'custom'.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "access": {
      "type": "object",
      "x-serverOnly": true,
      "x-icon": "shield-check",
      "description": "Who (besides server admins) can open & edit this script's live config — additive on top of dirk_lib's master admins (the dirk_lib_master_group convar), never removes their access. Enforced SERVER-SIDE by dirk_lib. x-serverOnly so the grant list never leaves the server.",
      "default": {
        "groups": [],
        "identifiers": []
      },
      "properties": {
        "groups": {
          "type": "array",
          "default": [],
          "description": "Job / gang / ACE group names granted config-edit access (checked via IsPlayerAceAllowed).",
          "items": {
            "type": "string"
          }
        },
        "identifiers": {
          "type": "array",
          "default": [],
          "description": "Specific players granted access — stored as the framework persistent id (citizenid on qb/qbx, license on esx).",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "paymentMethods": {
      "type": "array",
      "x-arrayKey": "id",
      "x-itemTitle": "name",
      "x-icon": "wallet",
      "description": "Every way a store can take money, or hand it over. Stores pick from this list. A method whose behaviour is not just \"move money in an account\" is written in overrides/paymentMethods.lua and keyed by the same id.",
      "x-rowOrder": [
        "id",
        "name",
        "symbol",
        "icon",
        "kind",
        "account",
        "item"
      ],
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "What stores refer to this method by, and the key an override in overrides/paymentMethods.lua uses. Changing it orphans every store that names it."
          },
          "name": {
            "type": "string",
            "description": "What the player sees on the payment switch."
          },
          "symbol": {
            "type": "string",
            "default": "$",
            "description": "Printed before the amount. Use it for a currency that is not your server default — a crypto method reading ₿ tells the player what they are spending."
          },
          "icon": {
            "type": "string",
            "x-control": "icon",
            "x-iconSet": "fontawesome",
            "description": "Shown beside the name."
          },
          "kind": {
            "type": "string",
            "default": "account",
            "enum": [
              "account",
              "item"
            ],
            "x-enumLabels": {
              "account": "Framework account",
              "item": "Inventory item"
            },
            "x-enumIcons": {
              "account": "landmark",
              "item": "package"
            },
            "description": "Whether paying moves money in a framework account, or hands over an item."
          },
          "account": {
            "type": "string",
            "x-control": "account",
            "x-enabledWhen": {
              "path": "self.kind",
              "equals": "account"
            },
            "description": "The framework account the money moves in."
          },
          "item": {
            "type": "string",
            "x-itemPicker": true,
            "x-enabledWhen": {
              "path": "self.kind",
              "equals": "item"
            },
            "description": "The item handed over, one per unit of price."
          }
        }
      },
      "default": [
        {
          "id": "cash",
          "name": "Cash",
          "symbol": "$",
          "icon": "fas fa-money-bill-wave",
          "kind": "account",
          "account": "cash"
        },
        {
          "id": "bank",
          "name": "Card",
          "symbol": "$",
          "icon": "fas fa-credit-card",
          "kind": "account",
          "account": "bank"
        },
        {
          "id": "black_money",
          "name": "Black Money",
          "symbol": "$",
          "icon": "fas fa-skull-crossbones",
          "kind": "account",
          "account": "black_money"
        }
      ]
    },
    "stores": {
      "type": "array",
      "x-arrayKey": "id",
      "x-itemTitle": "name",
      "x-icon": "store",
      "description": "Every shop on the map. Whether one can be opened at all — a licence check, a job check, a story beat — is behaviour, and lives in overrides/stores.lua keyed by the same id.",
