          "blip": {
            "type": "object",
            "description": "The map marker. Leave the sprite empty for a store with no blip at all.",
            "properties": {
              "sprite": {
                "type": "integer",
                "x-control": "blipSprite"
              },
              "color": {
                "type": "integer",
                "x-control": "blipColor"
              },
              "scale": {
                "type": "number",
                "minimum": 0,
                "maximum": 2,
