                  "Normal",
                  "Large",
                  "Huge"
                ]
              },
              "display": {
                "type": "integer",
                "x-control": "blipDisplay"
              },
              "shortRange": {
                "type": "boolean",
                "default": true,
                "description": "Only show the blip once the player is nearby."
              }
            },
            "default": {
              "sprite": 52,
              "color": 29,
              "scale": 0.8,
              "display": 4,
              "shortRange": true
            }
          },
          "openingHours": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "description": "When the shopkeeper is there. 0 to 24 is always open.",
